# ── App ────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Fase 1: Supabase (banco de dados) ─────────────────────
# Um projeto Supabase só (core e vertical no mesmo banco). Esquema: supabase/schema.sql.
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Connection string direta para PostgresSaver do LangGraph (memória persistente).
# Usar Transaction Pooler: Supabase → Project Settings → Database → URI (porta 6543).
# OBRIGATÓRIO: adicionar ?prepare_threshold=0 — o Transaction Pooler não suporta
# prepared statements, e o psycopg v3 os usa por padrão.
# Sem esta variável, o app faz fallback para MemorySaver (histórico perdido no restart).
SUPABASE_DB_URL=postgresql://postgres.[ref]:[senha]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?prepare_threshold=0

# ── Fase 3: Anthropic (LLM) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Fase 4: Webhook (segurança HMAC) ──────────────────────
WEBHOOK_SECRET=troque-por-um-segredo-forte

# Credenciais por clínica (OBRIGATÓRIAS, item 1.8): canais_whatsapp.
# credenciais_ref guarda só uma referência (ex: "WHATSAPP_CLINICA_X"), nunca a
# credencial em si. Para cada canal ativo, defina:
#   WHATSAPP_CLINICA_X_PHONE_NUMBER_ID=...
#   WHATSAPP_CLINICA_X_TOKEN=...
# Sem elas o canal NÃO envia (não há fallback global).
# Canal: SOMENTE API oficial da Meta (sem Evolution).

# ── Fase 4: Cloud API / Meta (WhatsApp oficial) ───────────
WHATSAPP_VERIFY_TOKEN=token-de-verificacao-do-webhook
# App Secret (HMAC dos webhooks). Na migração para o segundo app da Meta (Tech
# Provider) os dois valem; o webhook aceita a assinatura de qualquer um.
WHATSAPP_APP_SECRET=secret-do-app-antigo
WHATSAPP_APP_SECRET_SECUNDARIO=secret-do-app-secundario
# Credencial da PLATAFORMA: só para os alertas de erro (MONITOR_PHONE).
# Nunca usada para falar com paciente.
WHATSAPP_CLOUD_TOKEN=EAAxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=<phone_number_id do número da plataforma>

# ── Webhook interno (canal médico, single-tenant fase atual) ──
# Número WhatsApp do médico em E.164 — barreira de segurança e destino das respostas
INTERNO_MEDICO_WHATSAPP=+5567999991234
# tenant_id do médico no Supabase (tabela tenants do core)
INTERNO_TENANT_ID=<uuid do tenant>
# Nota: as respostas ao médico saem pelo canal principal da clínica.
# Roadmap: 2º número Meta dedicado ao canal interno quando disponível.

# ── Monitoramento de erros ────────────────────────────────
# Número WhatsApp que recebe alertas de erro do sistema (E.164)
MONITOR_PHONE=+5567999991234

# ── Agente ────────────────────────────────────────────────
# Nome do agente quando o tenant não define tenants.config.nome_agente
NOME_AGENTE_PADRAO=Assistente

# ── Transcrição de áudio (Groq Whisper) ───────────────────
# Obter em: https://console.groq.com → API Keys
# Modelo usado: whisper-large-v3-turbo (rápido, multilingual)
GROQ_API_KEY=gsk_...

# ── Fase 5: Langfuse (observabilidade) ────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Cifra dos tokens OAuth do Google em integracoes_oauth (item 1.7).
# 32 bytes em base64 (gerar com: openssl rand -base64 32). MESMO valor no
# painel CRM. Sem ela, tokens novos ficam em texto puro.
TOKENS_CRYPTO_KEY=
